{
  "name": "text-purifier",
  "version": "2.0.0",
  "description": "A TypeScript package to filter and censor bad words",
  "repository": {
    "type": "git",
    "url": "https://github.com/dipras/text-purifier"
  },
  "bugs": {
    "url": "https://github.com/dipras/text-purifier/issues"
  },
  "homepage": "https://github.com/dipras/text-purifier#readme",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config.json": "./config.json",
    "./ban-words/*.json": "./ban-words/*.json"
  },
  "type": "module",
  "sideEffects": false,
  "private": false,
  "scripts": {
    "build": "rollup -c",
    "prepare": "npm run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsc"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "picomatch": "4.0.5"
  },
  "keywords": [
    "filter",
    "bad-words",
    "censor",
    "profanity",
    "typescript"
  ],
  "author": "dipras",
  "license": "GPL-2.0-only",
  "files": [
    "dist",
    "config.json",
    "ban-words"
  ],
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.10.0",
    "rollup": "^4.59.0",
    "tslib": "^2.8.1",
    "typescript": "^5"
  }
}
